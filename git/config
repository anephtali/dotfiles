[user]
        email = anephtali@users.noreply.github.com
        name = Aurélien Nephtali
[core]
        editor = nvim
        whitespace = cr-at-eol
[push]
        default = simple
[alias]
        co = checkout
        br = branch
        ci = commit
        cs = commit -s
        st = status
        lo = log --pretty=format:'%C(auto)%h%d%Creset %C(cyan)(%cr)%Creset %C(green)%an%Creset %s'
        ln = log --oneline --no-merges
        adog = log --all --decorate --oneline --graph
[color]
        ui = auto
[pull]
        rebase = true
[diff]
        wsErrorHighlight = all
